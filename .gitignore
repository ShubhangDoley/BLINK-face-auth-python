# ── Model Weights (too large for git — use Releases or HuggingFace) ───────────
face-auth/models/*.onnx
face-auth/models/*.tflite
face-auth/models/*.pb
face-auth/models/*.h5
face-auth/models/mobile/

# ── User Data (privacy — enrolled faces and embeddings) ──────────────────────
face-auth/data/known_faces/
face-auth/data/users.json
face-auth/data/test/

# Keep the directory structure
!face-auth/data/.gitkeep
!face-auth/models/.gitkeep

