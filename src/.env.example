# BLINK Backend — Environment Configuration Template
# Copy this file to src/.env and fill in your credentials
# ⚠️  NEVER commit src/.env to git — it is gitignored for security

# ── Database ──────────────────────────────────────────────────────────────────
# Format: postgresql://[user]:[password]@[host]:[port]/[database]

# Local development (PostgreSQL)
# DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/blink_db

# AWS RDS (Production)
# DATABASE_URL=postgresql://postgres_blink:yourpassword@your-instance.xxxx.ap-south-1.rds.amazonaws.com:5432/blink_db

# Local SQLite fallback (no config needed — auto-activates when DATABASE_URL is not set)
# DATABASE_URL=sqlite:///cloud_blink.db
